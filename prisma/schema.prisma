// Loja Lenora — Schema Prisma (SQLite)
// Catálogo feminino + painel admin + pedidos via WhatsApp

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── CATEGORIAS ─────────────────────────
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

// ───────────────────────── PRODUTOS ─────────────────────────
model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String
  price         Float
  compareAt     Float?
  sku           String?
  status        String          @default("active") // active | draft | archived
  featured      Boolean         @default(false)
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  colors        ProductColor[]
  sizes         ProductSize[]
  reviews       ProductReview[]
  favorites     Favorite[]
  tags          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  // url webp servida em /uploads
  isMain    Boolean @default(false)
  order     Int     @default(0)

  @@index([productId])
}

// Cor do produto com hex real para mostrar o swatch
model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // ex: "Preto", "Off-white", "Vinho"
  hex       String  // ex: "#0a0a0a"
  stock     Int     @default(0)

  @@index([productId])
}

// Tamanhos: P, M, G, GG, Extra G, etc.
model ProductSize {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // ex: "P", "M", "G", "GG", "EXG"
  stock     Int     @default(0)

  @@index([productId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ───────────────────────── CUPONS ─────────────────────────
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // percent | fixed
  value       Float
  minSubtotal Float     @default(0)
  maxUses     Int       @default(0) // 0 = ilimitado
  usedCount   Int       @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ───────────────────────── CLIENTES (conta) ─────────────────────────
model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  favorites    Favorite[]
  orders       Order[]
  sessions     Session[]
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ───────────────────────── PEDIDOS (via WhatsApp) ─────────────────────────
model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // ex: LEN-2025-0001
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  customerCep    String?
  customerAddress String?
  items          OrderItem[]
  subtotal       Float
  discount       Float       @default(0)
  couponCode     String?
  shippingMethod String      // correios | transportadora | uber | retirada
  shippingCost   Float       @default(0)
  total          Float
  status         String      @default("recebido") // recebido | preparo | enviado | entregue | cancelado
  notes          String?
  whatsappSent   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  financialEntries FinancialEntry[]

  @@index([status])
  @@index([customerPhone])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  productImg  String?
  price       Float
  quantity    Int
  color       String?
  size        String?

  @@index([orderId])
}

// ───────────────────────── VISITAS (contador) ─────────────────────────
model Visit {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  ip        String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

// ───────────────────────── CONFIGURAÇÕES DO SITE ─────────────────────────
// Cores customizáveis, contato, SEO, redes sociais, horário...
// Chaves únicas; valores em JSON string.
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Sessões de cliente (auth simples por token)
model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ───────────────────────── FINANCEIRO ─────────────────────────
// Lançamentos financeiros (entradas e saídas). type = entrada | saida.
// category ex: "Venda", "Compra de estoque", "Frete", "Marketing", "Outro".
// status para contas a pagar/a receber: pendente | pago | recebido.
model FinancialEntry {
  id          String   @id @default(cuid())
  type        String   // entrada | saida
  description String
  category    String   // Venda, Estoque, Frete, Marketing, Fixo, Outro...
  amount      Float
  dueDate     DateTime?   // vencimento (a pagar / a receber)
  paidAt      DateTime?   // quando efetivado (null = pendente)
  status      String   @default("pendente") // pendente | pago | recebido
  method      String?  // pix, cartao, boleto, dinheiro, transferencia
  orderId     String?  // se vinculado a um pedido
  order       Order?   @relation(fields: [orderId], references: [id])
  supplierId  String?  // se vinculado a um fornecedor
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([dueDate])
}

// Fornecedores
model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?  // pessoa de contato
  phone     String?
  email     String?
  cnpj      String?
  notes     String?
  entries   FinancialEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
