# ─── AMBIENTE LOCAL (desenvolvimento) ───
# SQLite local — só para dev/preview. Em produção (Vercel) use PostgreSQL externo.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── AMBIENTE PRODUÇÃO (Vercel) ───
# Crie um banco PostgreSQL gratuito em https://neon.tech (ou Supabase/Vercel Postgres)
# e copie a connection string aqui (ou cadastre direto no painel da Vercel):
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/lenora?sslmode=require

# ─── Z.AI SDK (chatbot + skills) ───
# O SDK z-ai-web-dev-sdk usa credenciais injetadas automaticamente neste sandbox.
# Em produção (Vercel), se o chatbot parar de funcionar, é porque as credenciais
# do ZAI não estão configuradas — o fallback de busca por substring ainda funciona.

# ─── UPLOAD DE IMAGENS (VERCEL BLOB) ───
# Em produção, NÃO grave em public/uploads: o filesystem da Vercel é somente leitura.
# No painel da Vercel: Storage > Blob > Create/Connect Store > Public.
# Em stores legadas, a Vercel pode criar automaticamente BLOB_READ_WRITE_TOKEN.
# Em stores novas, o SDK também pode autenticar via OIDC quando o store está conectado ao projeto.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
