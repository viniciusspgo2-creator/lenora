# Loja Lenora — variáveis de ambiente de exemplo.
# Copie para .env e ajuste conforme o ambiente.

# ── LOCAL (SQLite — banco já vem em db/custom.db) ────────────────
DATABASE_URL="file:../db/custom.db"

# ── PRODUÇÃO (Vercel + Neon PostgreSQL) ──────────────────────────
# 1. Crie o banco em https://neon.tech e copie a connection string:
# DATABASE_URL="postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require"
#
# 2. Upload de imagens do painel (Vercel Blob):
#    Dashboard Vercel → Storage → Create Database → Blob → Connect to Project.
#    A variável abaixo é criada automaticamente pela Vercel:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Senha do painel admin (padrão: lenora2025 — pode ser trocada no painel)
# ADMIN_PASSWORD="lenora2025"
